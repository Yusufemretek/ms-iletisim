# Release signing configuration for Android
# Copy this file to keystore.properties and fill in your values.
# Then pass the path to gradle: -Pandroid.injected.signing.store.file=...
# Or set them as gradle properties in ~/.gradle/gradle.properties

MSI_RELEASE_STORE_FILE=ms-iletisim-release.keystore
MSI_RELEASE_STORE_PASSWORD=your_store_password
MSI_RELEASE_KEY_ALIAS=ms_iletisim
MSI_RELEASE_KEY_PASSWORD=your_key_password
